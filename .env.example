# Copy this file to `.env.local` and fill in real values.
# Only variables prefixed with VITE_ are exposed to the client bundle,
# so never place secret keys here — use them only in a backend proxy.

# Endpoint the contact form POSTs to. Examples:
#   Formspree:  https://formspree.io/f/xxxxxxxx
#   EmailJS:    a proxy endpoint that wraps EmailJS on your backend
#   Resend:     a proxy endpoint that calls Resend server-side
#   Custom:     your own /api/contact endpoint
# Leave empty to fall back to mailto:tang.darren@gmail.com after validation.
VITE_CONTACT_ENDPOINT=

# Optional: the public canonical origin used for SEO tags and sitemap generation.
# VITE_SITE_ORIGIN=https://yourdomain.com
