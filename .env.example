# Copy this file to `.env.local` and fill in real values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Never put secret API keys in NEXT_PUBLIC_ variables — keep secrets on a
# backend proxy only.

# Optional public contact-form POST endpoint (client-side). Examples:
#   Formspree:  https://formspree.io/f/xxxxxxxx
#   EmailJS:    a proxy endpoint that wraps EmailJS on your backend
#   Resend:     a proxy endpoint that calls Resend server-side
#   Custom:     your own /api/contact endpoint
# Leave empty to fall back to mailto:tang.darren@gmail.com after validation.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Server-only public site origin for canonical URLs, Open Graph / Twitter
# images, robots.txt, and sitemap.xml. No trailing slash.
# Falls back to http://localhost:3000 when unset (local development).
# Example production value:
# SITE_URL=https://yourdomain.com
SITE_URL=
